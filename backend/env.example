# Backend environment example for local development

# JWT
JWT_SECRET="your-super-secret-jwt-key"
NODE_ENV=development

# Email (NotificationAPI)
# Get these credentials from https://app.notificationapi.com/
# Client ID and Client Secret are found in Settings > API Keys
NOTIFICATIONAPI_CLIENT_ID=your_notificationapi_client_id_here
NOTIFICATIONAPI_CLIENT_SECRET=your_notificationapi_client_secret_here

# Cloudflare R2
# Base public URL for accessing objects (no trailing slash)
# Example for public bucket: https://pub-xxxxxxxxxxxxxxxx.r2.dev
# Example for custom domain: https://assets.example.com
R2_PUBLIC_BASE_URL=

# Wrangler also loads values from wrangler.toml [vars].
# You can override them here in local dev via dotenv support if used.

DATABASE_URL="file:./dev.db"
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CRON_SECRET="a-secure-secret-for-cron-jobs"

